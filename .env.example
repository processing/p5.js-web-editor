PORT=8000
PREVIEW_PORT=8002
EDITOR_URL=http://localhost:8000
PREVIEW_URL=http://localhost:8002
CORS_ALLOW_LOCALHOST=true
TRANSLATIONS_ENABLED=true
UPLOAD_LIMIT=250000000

# OpenProcessing variables
API_URL=https://openprocessing.org/api

# Optional deployment-wide override token. When set, it is used as the bearer
# for every OP API request and the per-user OAuth login flow is bypassed
# entirely. It is bundled into the page, so anyone who can load the editor can
# read it — only use this for self-hosted / single-user / embedded / CI setups,
# never on a shared public deployment. Leave unset to use normal OAuth login.
# You can generate an API token at https://openprocessing.org/@<your-username>/#edit
# API_TOKEN=op_<your-api-token>

# Optional: public OpenProcessing sketch (visualID) used as the animated
# background on the 404 page. Leave unset for a plain 404 page.
OP_404_SKETCH_ID=

# Path to the OpenProcessing collection shown as the editor's "Examples" menu
# item, e.g. /username/collections/collectionId. Leave unset to hide Examples.
EXAMPLES_ENDPOINT=
